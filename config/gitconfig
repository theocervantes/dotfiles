# Shared git defaults, included from ~/.gitconfig by bootstrap-dev-vm.sh.
# No name or email here: identity is set per VM and stays out of this repo.

[init]
	defaultBranch = main
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
[pull]
	rebase = true
